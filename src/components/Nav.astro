---
import NavLink from "./NavLink.astro";
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"nav">;

const { class: className, ...props } = Astro.props;
---

<nav
  class:list={[
    "flex h-15 items-center justify-start gap-5 bg-linear-to-b from-paper from-75% to-transparent max-lg:px-5 text-sm text-light-tx-2",
    className,
  ]}
  {...props}
>
  <NavLink data-story-scroll-to-line data-story-restart href="#one">
    restart
  </NavLink>
  <NavLink data-story-scroll-to-line href="#ten"> contact </NavLink>
  <NavLink
    target="_blank"
    rel="noopener noreferrer"
    href="https://www.linkedin.com/in/damian-struk/"
  >
    linkedin
  </NavLink>
</nav>
