---
import Nav from "./Nav.astro";
import StoryLine from "./StoryLine.astro";
---

<div
  class="_story-viewport group fixed inset-x-5 bottom-0 z-20 grid h-1/3 bg-dark-bg text-lg lg:sticky lg:inset-x-auto lg:top-0 lg:bottom-auto lg:h-screen lg:w-full"
  data-loaded="false"
>
  <Nav />
  <section class="relative col-start-1 row-start-1 z-40 h-full">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-50 h-32 -translate-y-1/2 bg-linear-to-b from-transparent via-dark-bg to-75% to-transparent lg:hidden"
      aria-hidden="true"
    >
    </div>
    <div
      class="_story-mask grid h-full items-start overflow-hidden lg:place-items-center"
    >
      <div class="_story-lines w-full max-lg:mt-8 text-paper">
        <StoryLine id="hero-simple">software should feel simple.</StoryLine>
        <StoryLine id="mission-arrive" spaced
          >ideas rarely arrive neatly.
        </StoryLine>
        <StoryLine id="mission-people" spaced>
          they move through people before they move through systems.
        </StoryLine>
        <StoryLine id="mission-detail">
          someone points to a detail, refers back to something,
        </StoryLine>
        <StoryLine id="mission-frame">
          changes the frame, or notices what was missing.
        </StoryLine>
        <StoryLine id="mission-motion" spaced>
          good software should understand that kind of motion.
        </StoryLine>
        <StoryLine id="mission-natural">
          it should feel natural to use, clear enough to trust,
        </StoryLine>
        <StoryLine id="mission-quiet">
          and quiet enough to let the work stay in front.
        </StoryLine>
        <StoryLine id="contact-complex" spaced>
          bring me the complex idea.
        </StoryLine>
        <StoryLine id="contact-simple" spaced>
          i'll turn it into simple software.
        </StoryLine>
        <span class="_story-contact-position mt-2 block h-0" aria-hidden="true"
        ></span>
      </div>
    </div>
    <p
      class="_story-contact absolute inset-x-0 z-50 text-paper opacity-0 data-[loaded=true]:transition-opacity data-[loaded=true]:duration-300 data-[loaded=true]:ease-in-out"
      data-loaded="false"
      aria-hidden="true"
    >
      <a
        class="text-inherit no-underline outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
        href="mailto:hello@example.com"
      >
        hello@example.com
      </a>
    </p>
  </section>
</div>

<style>
  ._story-mask {
    --story-core-half-height: 6rem;
    --story-falloff-half-height: 40%;
    --story-mask-center: 50%;

    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--story-mask-center) - var(--story-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--story-mask-center) - var(--story-core-half-height)),
      black var(--story-mask-center),
      rgb(0 0 0 / 0.4)
        calc(var(--story-mask-center) + var(--story-core-half-height)),
      transparent
        calc(var(--story-mask-center) + var(--story-falloff-half-height)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--story-mask-center) - var(--story-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--story-mask-center) - var(--story-core-half-height)),
      black var(--story-mask-center),
      rgb(0 0 0 / 0.4)
        calc(var(--story-mask-center) + var(--story-core-half-height)),
      transparent
        calc(var(--story-mask-center) + var(--story-falloff-half-height)),
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  ._story-lines {
    --story-origin-offset: 0px;
    --story-scroll-offset: 0px;

    transform: translateY(
      calc(var(--story-origin-offset) + var(--story-scroll-offset))
    );
    will-change: transform;
  }
</style>
