---
import "../styles/global.css";
import Story from "../components/Story.astro";
import VisualSequence from "../components/VisualSequence.astro";
import StoryScroll from "../components/StoryScroll.astro";
import Nav from "../components/Nav.astro";
import ogImageSource from "../assets/og-image.png";
import { Font, getImage } from "astro:assets";

const title = "Revised";
const description =
  "Bringing complex ideas to life with simple, thoughtful software.";

const ogUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({
  src: ogImageSource,
  width: 1200,
  height: 675,
  format: "jpg",
  quality: 85,
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-newsreader" preload />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta
      property="og:image:width"
      content={ogImage.options.width?.toString()}
    />
    <meta
      property="og:image:height"
      content={ogImage.options.height?.toString()}
    />
  </head>
  <body class="bg-paper text-light-tx-2 font-serif font-medium">
    <Nav class="lg:hidden sticky top-0 z-50" />
    <main
      class="mx-auto grid w-full max-w-screen-2xl grid-cols-1 lg:grid-cols-2 lg:justify-between lg:px-5"
      data-story
    >
      <Story />
      <VisualSequence />
    </main>
    <StoryScroll />
  </body>
</html>
