---
import Nav from "./Nav.astro";
import StoryLine from "./StoryLine.astro";
---

<div
  class="fixed inset-x-0 bottom-0 z-20 grid h-[33svh] bg-paper text-lg lg:sticky lg:inset-x-auto lg:top-0 lg:bottom-auto lg:h-screen lg:w-full"
>
  <Nav class="max-lg:hidden col-start-1 row-start-1" />
  <div
    class="pointer-events-none absolute inset-x-0 top-0 z-50 h-32 -translate-y-1/2 bg-linear-to-b from-transparent via-paper to-75% to-transparent lg:hidden"
    aria-hidden="true"
  >
  </div>
  <section class="relative col-start-1 row-start-1 z-40 h-full pr-5">
    <div
      class="_story-mask relative h-full overflow-hidden [--story-mask-center:calc(2rem+0.5lh)] lg:[--story-mask-center:50%]"
    >
      <div
        class="absolute top-(--story-mask-center) mt-[-0.5lh] w-full translate-y-(--story-scroll-offset) text-light-tx-2 will-change-transform [--story-scroll-offset:0px] max-lg:px-5"
        data-story-track
      >
        <StoryLine id="one"> software should <i>feel</i> simple </StoryLine>
        <StoryLine id="two" spaced>
          so you can focus on what matters.
        </StoryLine>
        <StoryLine id="three" spaced>
          good software moves out of your way.
        </StoryLine>
        <StoryLine id="four"> it works quietly in the background </StoryLine>
        <StoryLine id="five"> without asking you for attention. </StoryLine>
        <StoryLine id="six" spaced>
          your time should go into the work itself.
        </StoryLine>
        <StoryLine id="seven"> the complexity should be invisible </StoryLine>
        <StoryLine id="eight"> and it is my job to hide it. </StoryLine>
        <StoryLine id="nine" spaced> bring me the complexity, </StoryLine>
        <StoryLine id="ten" spaced>
          i will turn it into <i>simple</i> software.
        </StoryLine>
      </div>
    </div>
    <p
      class="in-data-story-ready:transition-opacity in-data-story-ready:duration-300 in-data-story-ready:ease-in-out in-data-story-end:opacity-100 pointer-events-none in-data-story-end:pointer-events-auto absolute inset-x-0 z-50 translate-y-(--story-scroll-offset) text-light-tx-2 opacity-0 [--story-scroll-offset:0px] max-lg:px-5"
      data-story-contact
      aria-hidden="true"
    >
      <a
        class="text-inherit no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
        href="mailto:contact@revised.pl"
        tabindex="-1"
      >
        contact@revised.pl
      </a>
    </p>
  </section>
</div>

<style>
  ._story-mask {
    --story-core-half-height: 6rem;
    --story-falloff-half-height: 33%;
    --story-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(from var(--color-black) r g b / 0.3),
      var(--color-black) var(--story-mask-center),
      rgb(from var(--color-black) r g b / 0.3)
        calc(var(--story-mask-center) + var(--story-core-half-height)),
      transparent 100%
    );

    -webkit-mask-image: var(--story-mask-image);
    mask-image: var(--story-mask-image);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  @media (min-width: 64rem) {
    ._story-mask {
      --story-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        transparent
          calc(var(--story-mask-center) - var(--story-falloff-half-height)),
        rgb(from var(--color-black) r g b / 0.4)
          calc(var(--story-mask-center) - var(--story-core-half-height)),
        var(--color-black) var(--story-mask-center),
        rgb(from var(--color-black) r g b / 0.4)
          calc(var(--story-mask-center) + var(--story-core-half-height)),
        transparent
          calc(var(--story-mask-center) + var(--story-falloff-half-height)),
        transparent 100%
      );
    }
  }
</style>
