<script>
  const root = document.documentElement;
  const storyTrack = document.querySelector<HTMLElement>("[data-story-track]")!;
  const lines = Array.from(
    document.querySelectorAll<HTMLElement>("[data-story-line-id]"),
  );
  const contact = document.querySelector<HTMLElement>("[data-story-contact]")!;
  const contactLink = contact.querySelector<HTMLAnchorElement>("a")!;

  const lineIds = lines.map((line) => line.dataset.storyLineId!);
  const lastIndex = lines.length - 1;

  interface StoryMetrics {
    lineOffsets: number[];
    maxScroll: number;
    contactTop: number;
  }

  interface StoryRenderValues {
    scrollOffset: number;
    activeIndex: number;
    atEnd: boolean;
  }

  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);

  const indexFromHash = () => {
    const index = lineIds.indexOf(location.hash.slice(1));
    return index < 0 ? 0 : index;
  };

  const progressFromIndex = (index: number) => index / lastIndex;

  const scrollProgress = (maxScroll: number) => {
    const documentHeight = document.documentElement.scrollHeight;

    if (Math.ceil(window.scrollY + window.innerHeight) >= documentHeight) {
      return 1;
    }

    return maxScroll === 0 ? 0 : clamp(window.scrollY / maxScroll);
  };

  const metricsFromLayout = (): StoryMetrics => {
    const lineCenters = lines.map(
      (line) => line.offsetTop + line.offsetHeight / 2,
    );
    const firstLineCenter = lineCenters[0];

    return {
      lineOffsets: lineCenters.map(
        (lineCenter) => firstLineCenter - lineCenter,
      ),
      maxScroll: document.documentElement.scrollHeight - window.innerHeight,
      contactTop: storyTrack.offsetTop + storyTrack.offsetHeight,
    };
  };

  const applyMetrics = (metrics: StoryMetrics) => {
    contact.style.top = `${metrics.contactTop}px`;
  };

  const syncHash = (index: number) => {
    const hash = `#${lineIds[index]}`;

    if (location.hash !== hash) {
      history.replaceState(null, "", hash);
    }
  };

  const renderValuesFromProgress = (
    progress: number,
    lineOffsets: number[],
  ): StoryRenderValues => {
    const position = clamp(progress) * lastIndex;
    const fromIndex = Math.floor(position);
    const toIndex = Math.ceil(position);
    const mix = position - fromIndex;

    return {
      scrollOffset:
        lineOffsets[fromIndex] +
        (lineOffsets[toIndex] - lineOffsets[fromIndex]) * mix,
      activeIndex: Math.round(position),
      atEnd: progress >= 1,
    };
  };

  const applyRender = (
    values: StoryRenderValues,
    previousActiveIndex: number,
    updateHash = true,
  ) => {
    const { scrollOffset, activeIndex, atEnd } = values;

    storyTrack.style.setProperty("--story-scroll-offset", `${scrollOffset}px`);
    contact.style.setProperty("--story-scroll-offset", `${scrollOffset}px`);
    root.toggleAttribute("data-story-end", atEnd);

    if (atEnd) {
      contact.removeAttribute("aria-hidden");
      contactLink.removeAttribute("tabindex");
    } else {
      contact.setAttribute("aria-hidden", "true");
      contactLink.setAttribute("tabindex", "-1");
    }

    if (activeIndex !== previousActiveIndex && updateHash) {
      syncHash(activeIndex);
    }
  };

  const scrollToIndex = (
    index: number,
    behavior: ScrollBehavior,
    maxScroll: number,
  ) => {
    syncHash(index);
    window.scrollTo({
      top: maxScroll * progressFromIndex(index),
      behavior,
    });
  };

  history.scrollRestoration = "manual";
  root.removeAttribute("data-story-end");
  root.removeAttribute("data-story-ready");

  let metrics = metricsFromLayout();
  applyMetrics(metrics);

  const initialIndex = indexFromHash();
  const initialProgress = progressFromIndex(initialIndex);
  const initialRender = renderValuesFromProgress(
    initialProgress,
    metrics.lineOffsets,
  );
  let activeIndex = initialRender.activeIndex;

  applyRender(initialRender, initialIndex, false);
  window.scrollTo({
    top: metrics.maxScroll * initialProgress,
    behavior: "auto",
  });
  root.setAttribute("data-story-ready", "");

  window.addEventListener(
    "scroll",
    () => {
      const values = renderValuesFromProgress(
        scrollProgress(metrics.maxScroll),
        metrics.lineOffsets,
      );
      applyRender(values, activeIndex);
      activeIndex = values.activeIndex;
    },
    { passive: true },
  );

  document
    .querySelectorAll<HTMLAnchorElement>("[data-story-scroll-to-line]")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        scrollToIndex(
          lineIds.indexOf(link.hash.slice(1)),
          "smooth",
          metrics.maxScroll,
        );
      });
    });

  window.addEventListener("hashchange", () => {
    scrollToIndex(indexFromHash(), "auto", metrics.maxScroll);
  });

  window.addEventListener("resize", () => {
    metrics = metricsFromLayout();
    applyMetrics(metrics);

    const values = renderValuesFromProgress(
      scrollProgress(metrics.maxScroll),
      metrics.lineOffsets,
    );
    applyRender(values, activeIndex, false);
    activeIndex = values.activeIndex;
  });
</script>
