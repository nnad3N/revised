---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  priority?: boolean;
}

const { image, alt, priority = false } = Astro.props;
const textureImage = await getImage({
  src: image,
  width: image.width,
  height: image.height,
  format: "webp",
  quality: "max",
});
---

<div
  class="relative aspect-square w-full lg:max-w-[calc(100dvh-5rem)] shadow-lg select-none overflow-hidden rounded-md"
>
  <Image
    src={image}
    alt={alt}
    width={image.width}
    height={image.height}
    widths={[320, 480, 640, 768, 1024, 1536, 2048]}
    sizes="(min-width: 96rem) 44.25rem, (min-width: 64rem) calc(50vw - 3.75rem), calc(100vw - 2.5rem)"
    format="webp"
    quality="max"
    priority={priority}
    draggable={false}
  />
  <div
    class="group/lens absolute inset-0 touch-pan-y data-dragging:cursor-none data-dragging:**:cursor-none"
    data-lens
    data-texture-src={textureImage.src}
  >
    <canvas
      class="pointer-events-none absolute inset-0 size-full opacity-0 transition-opacity duration-400 ease-[ease] group-data-ready/lens:opacity-100"
      aria-hidden="true"></canvas>
    <button
      class="absolute -translate-x-1/2 -translate-y-1/2 scale-(--lens-press-scale) touch-none cursor-grab rounded-full outline-none [--lens-press-scale:1]"
      data-lens-handle
      type="button"
      aria-label="Magnifying lens. Use the arrow keys to move it and plus or minus to resize it."
    >
    </button>
    <span class="sr-only" aria-live="polite" data-lens-status>
      Lens position 87% from the left and 87% from the top. Lens size 20%.
    </span>
  </div>
</div>

<script>
  import LensWorker from "../workers/lens.worker?worker";

  const MAX_DPR = 1.5;
  const LENS_SIZE = 0.2;
  const LENS_SIZE_MIN = 0.08;
  const LENS_SIZE_MAX = 0.45;
  const LENS_SIZE_WHEEL_SENSITIVITY = 0.0002;
  const LENS_BEZEL = 0.012;
  const LENS_ZOOM = 2;
  const LENS_REFRACTION = 0.01;
  const LENS_INITIAL_EDGE_GAP = 0.03;
  const LENS_INITIAL_CENTER = 1 - LENS_SIZE / 2 - LENS_INITIAL_EDGE_GAP;
  const LENS_HOVER_LIGHT_ANGLE = (Math.PI * 5) / 180;
  const LENS_LIGHT_ROTATE_DURATION = 250;
  const KEYBOARD_MOVE_SPEED = 0.42;
  const KEYBOARD_RESIZE_SPEED = 0.24;
  const KEYBOARD_NUDGE_DURATION = 1 / 40;
  const KEYBOARD_MAX_FRAME_DURATION = 1 / 20;

  interface Point {
    x: number;
    y: number;
  }

  type KeyboardAction =
    "move-up" | "move-down" | "move-left" | "move-right" | "grow" | "shrink";

  interface Context {
    root: HTMLElement;
    handle: HTMLButtonElement;
    status: HTMLElement;
    worker: Worker;
    center: Point;
    dragOffset: Point;
    touches: Map<number, Point>;
    pinchDistance: number;
    pinchLensSize: number;
    lensSize: number;
    pointerId: number | null;
    press: number;
    pressAnimationFrame: number | null;
    lightAngle: number;
    lightAnimationFrame: number | null;
    keyboardActions: Set<KeyboardAction>;
    keyboardAnimationFrame: number | null;
    keyboardLastTime: number;
  }

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const lensZoomFromSize = (lensSize: number) =>
    LENS_ZOOM * Math.sqrt(lensSize / LENS_SIZE);

  const lensBezelFromSize = (lensSize: number) =>
    LENS_BEZEL * (lensSize / LENS_SIZE);

  const distanceBetween = (first: Point, second: Point) =>
    Math.hypot(second.x - first.x, second.y - first.y);

  const contexts: Context[] = [];

  const easeInOut = (progress: number) =>
    0.5 - Math.cos(progress * Math.PI) * 0.5;

  const statusFromLens = (center: Point, lensSize: number) =>
    `Lens position ${Math.round(center.x * 100)}% from the left and ${Math.round(center.y * 100)}% from the top. Lens size ${Math.round(lensSize * 100)}%.`;

  const keyboardActionFromEvent = (
    event: KeyboardEvent,
  ): KeyboardAction | null => {
    if (event.key === "ArrowUp") return "move-up";
    if (event.key === "ArrowDown") return "move-down";
    if (event.key === "ArrowLeft") return "move-left";
    if (event.key === "ArrowRight") return "move-right";
    if (event.key === "+" || event.code === "NumpadAdd") return "grow";
    if (event.key === "-" || event.code === "NumpadSubtract") return "shrink";
    return null;
  };

  const resizeDirectionFromActions = (actions: Set<KeyboardAction>) => {
    let direction = 0;

    actions.forEach((action) => {
      if (action === "grow") direction = 1;
      if (action === "shrink") direction = -1;
    });

    return direction;
  };

  const syncStatus = (ctx: Context) => {
    ctx.status.textContent = statusFromLens(ctx.center, ctx.lensSize);
  };

  const syncHandle = (ctx: Context) => {
    ctx.handle.style.width = `${ctx.lensSize * 100}%`;
    ctx.handle.style.height = `${ctx.lensSize * 100}%`;
    ctx.handle.style.left = `${ctx.center.x * 100}%`;
    ctx.handle.style.top = `${ctx.center.y * 100}%`;
    ctx.handle.style.setProperty(
      "--lens-press-scale",
      `${1 + ctx.press * 0.035}`,
    );
  };

  const renderLens = (ctx: Context) => {
    syncHandle(ctx);
    ctx.worker.postMessage({
      type: "render",
      centerX: ctx.center.x,
      centerY: ctx.center.y,
      lensSize: ctx.lensSize,
      bezelWidth: lensBezelFromSize(ctx.lensSize),
      zoom: lensZoomFromSize(ctx.lensSize),
      refraction: LENS_REFRACTION,
      press: ctx.press,
      lightAngle: ctx.lightAngle,
    });
  };

  const applyKeyboardMotion = (ctx: Context, duration: number) => {
    let horizontal =
      Number(ctx.keyboardActions.has("move-right")) -
      Number(ctx.keyboardActions.has("move-left"));
    let vertical =
      Number(ctx.keyboardActions.has("move-down")) -
      Number(ctx.keyboardActions.has("move-up"));
    const directionLength = Math.hypot(horizontal, vertical);

    if (directionLength > 1) {
      horizontal /= directionLength;
      vertical /= directionLength;
    }

    const resizeDirection = resizeDirectionFromActions(ctx.keyboardActions);

    ctx.center.x = clamp(
      ctx.center.x + horizontal * KEYBOARD_MOVE_SPEED * duration,
      0,
      1,
    );
    ctx.center.y = clamp(
      ctx.center.y + vertical * KEYBOARD_MOVE_SPEED * duration,
      0,
      1,
    );
    ctx.lensSize = clamp(
      ctx.lensSize + resizeDirection * KEYBOARD_RESIZE_SPEED * duration,
      LENS_SIZE_MIN,
      LENS_SIZE_MAX,
    );
    renderLens(ctx);
  };

  const startKeyboardMotion = (ctx: Context) => {
    if (ctx.keyboardAnimationFrame !== null) return;

    ctx.keyboardLastTime = performance.now();
    animatePress(ctx, 1);

    const tick = (now: number) => {
      if (ctx.keyboardActions.size === 0) {
        ctx.keyboardAnimationFrame = null;
        syncStatus(ctx);
        return;
      }

      const duration = clamp(
        (now - ctx.keyboardLastTime) / 1000,
        0,
        KEYBOARD_MAX_FRAME_DURATION,
      );
      ctx.keyboardLastTime = now;
      applyKeyboardMotion(ctx, duration);
      ctx.keyboardAnimationFrame = requestAnimationFrame(tick);
    };

    ctx.keyboardAnimationFrame = requestAnimationFrame(tick);
  };

  const stopKeyboardMotion = (ctx: Context) => {
    ctx.keyboardActions.clear();

    if (ctx.keyboardAnimationFrame !== null) {
      cancelAnimationFrame(ctx.keyboardAnimationFrame);
      ctx.keyboardAnimationFrame = null;
    }

    syncStatus(ctx);
  };

  const animateLightAngle = (ctx: Context, target: number) => {
    if (ctx.lightAnimationFrame !== null) {
      cancelAnimationFrame(ctx.lightAnimationFrame);
    }

    const from = ctx.lightAngle;
    const start = performance.now();

    const tick = (now: number) => {
      const progress = clamp((now - start) / LENS_LIGHT_ROTATE_DURATION, 0, 1);
      ctx.lightAngle = from + (target - from) * easeInOut(progress);
      renderLens(ctx);

      if (progress < 1) {
        ctx.lightAnimationFrame = requestAnimationFrame(tick);
      } else {
        ctx.lightAngle = target;
        ctx.lightAnimationFrame = null;
      }
    };

    ctx.lightAnimationFrame = requestAnimationFrame(tick);
  };

  const animatePress = (ctx: Context, target: number) => {
    if (ctx.pressAnimationFrame !== null) {
      cancelAnimationFrame(ctx.pressAnimationFrame);
    }

    const from = ctx.press;
    const start = performance.now();
    const duration = target > from ? 180 : 240;

    const tick = (now: number) => {
      const progress = clamp((now - start) / duration, 0, 1);
      const eased = 1 - Math.pow(1 - progress, target > from ? 3 : 4);
      ctx.press = from + (target - from) * eased;
      renderLens(ctx);

      if (progress < 1) {
        ctx.pressAnimationFrame = requestAnimationFrame(tick);
      } else {
        ctx.press = target;
        ctx.pressAnimationFrame = null;
      }
    };

    ctx.pressAnimationFrame = requestAnimationFrame(tick);
  };

  const setLensFromPointer = (
    ctx: Context,
    clientX: number,
    clientY: number,
  ) => {
    const rect = ctx.root.getBoundingClientRect();
    const pointerX = (clientX - rect.left) / rect.width;
    const pointerY = (clientY - rect.top) / rect.height;
    ctx.center.x = clamp(pointerX - ctx.dragOffset.x, 0, 1);
    ctx.center.y = clamp(pointerY - ctx.dragOffset.y, 0, 1);
    renderLens(ctx);
  };

  const endDrag = (ctx: Context) => {
    ctx.pointerId = null;
    ctx.root.removeAttribute("data-dragging");
    animatePress(ctx, 0);
    syncStatus(ctx);
  };

  const bindInteraction = (ctx: Context) => {
    ctx.root.addEventListener("pointerenter", () => {
      animateLightAngle(ctx, LENS_HOVER_LIGHT_ANGLE);
    });

    ctx.root.addEventListener("pointerleave", () => {
      animateLightAngle(ctx, 0);
    });

    ctx.handle.addEventListener("pointerdown", (event) => {
      if (ctx.pointerId !== null) return;

      const rect = ctx.root.getBoundingClientRect();
      ctx.pointerId = event.pointerId;
      ctx.dragOffset.x =
        (event.clientX - rect.left) / rect.width - ctx.center.x;
      ctx.dragOffset.y =
        (event.clientY - rect.top) / rect.height - ctx.center.y;
      ctx.handle.setPointerCapture(event.pointerId);
      ctx.root.dataset.dragging = "";
      animatePress(ctx, 1);
    });

    ctx.handle.addEventListener("pointermove", (event) => {
      if (event.pointerId !== ctx.pointerId) return;
      setLensFromPointer(ctx, event.clientX, event.clientY);
    });

    const finishHandleDrag = (event: PointerEvent) => {
      if (event.pointerId !== ctx.pointerId) return;
      endDrag(ctx);
    };

    ctx.handle.addEventListener("pointerup", finishHandleDrag);
    ctx.handle.addEventListener("pointercancel", finishHandleDrag);
    ctx.handle.addEventListener("lostpointercapture", finishHandleDrag);

    ctx.handle.addEventListener("focus", () => {
      if (ctx.pointerId === null) animatePress(ctx, 1);
      animateLightAngle(ctx, LENS_HOVER_LIGHT_ANGLE);
    });

    ctx.handle.addEventListener("blur", () => {
      stopKeyboardMotion(ctx);
      animatePress(ctx, 0);
      animateLightAngle(ctx, 0);
    });

    ctx.handle.addEventListener("keydown", (event) => {
      const action = keyboardActionFromEvent(event);
      if (action === null) return;

      event.preventDefault();
      if (ctx.keyboardActions.has(action)) return;

      ctx.keyboardActions.add(action);
      applyKeyboardMotion(ctx, KEYBOARD_NUDGE_DURATION);
      startKeyboardMotion(ctx);
    });

    ctx.handle.addEventListener("keyup", (event) => {
      const action = keyboardActionFromEvent(event);
      if (action === null) return;

      event.preventDefault();
      ctx.keyboardActions.delete(action);
      if (ctx.keyboardActions.size === 0) stopKeyboardMotion(ctx);
    });

    ctx.root.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;

      ctx.touches.set(event.pointerId, {
        x: event.clientX,
        y: event.clientY,
      });

      if (ctx.touches.size !== 2) return;

      if (ctx.pointerId !== null) endDrag(ctx);
      const [first, second] = Array.from(ctx.touches.values());
      ctx.pinchDistance = distanceBetween(first, second);
      ctx.pinchLensSize = ctx.lensSize;
      ctx.root.setPointerCapture(event.pointerId);
    });

    ctx.root.addEventListener("pointermove", (event) => {
      if (!ctx.touches.has(event.pointerId)) return;

      ctx.touches.set(event.pointerId, {
        x: event.clientX,
        y: event.clientY,
      });
      if (ctx.touches.size < 2 || ctx.pinchDistance === 0) return;

      const [first, second] = Array.from(ctx.touches.values());
      const distance = distanceBetween(first, second);
      ctx.lensSize = clamp(
        ctx.pinchLensSize * (distance / ctx.pinchDistance),
        LENS_SIZE_MIN,
        LENS_SIZE_MAX,
      );
      renderLens(ctx);
    });

    const finishTouch = (event: PointerEvent) => {
      const wasPinching = ctx.pinchDistance !== 0;
      ctx.touches.delete(event.pointerId);
      if (ctx.touches.size < 2) {
        ctx.pinchDistance = 0;
        if (wasPinching) syncStatus(ctx);
      }
    };

    ctx.root.addEventListener("pointerup", finishTouch);
    ctx.root.addEventListener("pointercancel", finishTouch);

    ctx.root.addEventListener(
      "wheel",
      (event) => {
        if (ctx.pointerId === null) return;

        event.preventDefault();
        ctx.lensSize = clamp(
          ctx.lensSize - event.deltaY * LENS_SIZE_WHEEL_SENSITIVITY,
          LENS_SIZE_MIN,
          LENS_SIZE_MAX,
        );
        renderLens(ctx);
      },
      { passive: false },
    );
  };

  const initializeLens = (root: HTMLElement) => {
    root.dataset.initialized = "";

    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    const handle = root.querySelector<HTMLButtonElement>("[data-lens-handle]")!;
    const status = root.querySelector<HTMLElement>("[data-lens-status]")!;
    const worker = new LensWorker();

    const ctx: Context = {
      root,
      handle,
      status,
      worker,
      center: { x: LENS_INITIAL_CENTER, y: LENS_INITIAL_CENTER },
      dragOffset: { x: 0, y: 0 },
      touches: new Map(),
      pinchDistance: 0,
      pinchLensSize: LENS_SIZE,
      lensSize: LENS_SIZE,
      pointerId: null,
      press: 0,
      pressAnimationFrame: null,
      lightAngle: 0,
      lightAnimationFrame: null,
      keyboardActions: new Set(),
      keyboardAnimationFrame: null,
      keyboardLastTime: 0,
    };
    contexts.push(ctx);
    bindInteraction(ctx);
    syncHandle(ctx);

    worker.addEventListener("message", (event) => {
      if (event.data.type === "ready") root.dataset.ready = "";
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      const size = Math.max(1, Math.round(root.clientWidth * dpr));
      worker.postMessage({ type: "resize", size });
    };

    const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
    const size = Math.max(1, Math.round(root.clientWidth * dpr));
    const offscreen = canvas.transferControlToOffscreen();
    worker.postMessage(
      {
        type: "init",
        canvas: offscreen,
        textureSrc: root.dataset.textureSrc!,
        size,
        centerX: ctx.center.x,
        centerY: ctx.center.y,
        lensSize: ctx.lensSize,
        bezelWidth: lensBezelFromSize(ctx.lensSize),
        zoom: lensZoomFromSize(ctx.lensSize),
        refraction: LENS_REFRACTION,
        press: ctx.press,
        lightAngle: ctx.lightAngle,
      },
      [offscreen],
    );

    new ResizeObserver(resize).observe(root);
  };

  document
    .querySelectorAll<HTMLElement>("[data-lens]:not([data-initialized])")
    .forEach((root) => initializeLens(root));

  document
    .querySelectorAll<HTMLElement>("[data-story-restart]")
    .forEach((restart) => {
      restart.addEventListener("click", () => {
        contexts.forEach((ctx) => {
          if (ctx.pressAnimationFrame !== null) {
            cancelAnimationFrame(ctx.pressAnimationFrame);
            ctx.pressAnimationFrame = null;
          }

          if (ctx.lightAnimationFrame !== null) {
            cancelAnimationFrame(ctx.lightAnimationFrame);
            ctx.lightAnimationFrame = null;
          }

          if (ctx.keyboardAnimationFrame !== null) {
            cancelAnimationFrame(ctx.keyboardAnimationFrame);
            ctx.keyboardAnimationFrame = null;
          }

          ctx.center.x = LENS_INITIAL_CENTER;
          ctx.center.y = LENS_INITIAL_CENTER;
          ctx.dragOffset.x = 0;
          ctx.dragOffset.y = 0;
          ctx.touches.clear();
          ctx.pinchDistance = 0;
          ctx.pinchLensSize = LENS_SIZE;
          ctx.lensSize = LENS_SIZE;
          ctx.pointerId = null;
          ctx.press = 0;
          ctx.lightAngle = 0;
          ctx.keyboardActions.clear();
          ctx.keyboardLastTime = 0;
          ctx.root.removeAttribute("data-dragging");
          renderLens(ctx);
          syncStatus(ctx);
        });
      });
    });
</script>
