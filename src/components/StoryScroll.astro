<script>
  const storyViewport =
    document.querySelector<HTMLElement>("._story-viewport")!;
  const storyMask = document.querySelector<HTMLElement>("._story-mask")!;
  const storyTrack = document.querySelector<HTMLElement>("._story-lines")!;
  const lines = Array.from(
    document.querySelectorAll<HTMLElement>("._story-line"),
  );
  const contact = document.querySelector<HTMLElement>("._story-contact")!;
  const contactPosition = document.querySelector<HTMLElement>(
    "._story-contact-position",
  )!;
  const storySection = contact.parentElement!;

  const lineIds = lines.map((line) => line.id);
  const lastIndex = lines.length - 1;

  let lineOffsets: number[] = [];
  let activeIndex = -1;
  let maxScroll = 0;
  let contactVisible = false;
  let originOffset = 0;
  let scrollOffset = 0;

  const clamp = (value: number) => Math.min(Math.max(value, 0), 1);

  const indexFromHash = () => {
    const index = lineIds.indexOf(location.hash.slice(1));
    return index < 0 ? 0 : index;
  };

  const progressFromIndex = (index: number) => index / lastIndex;

  const measure = () => {
    maxScroll = document.documentElement.scrollHeight - window.innerHeight;

    const viewportTop = storyViewport.getBoundingClientRect().top;
    const maskRect = storyMask.getBoundingClientRect();
    const maskStyles = getComputedStyle(storyMask);
    const currentTranslation = originOffset + scrollOffset;
    const firstLineRect = lines[0].getBoundingClientRect();
    const anchorTop =
      maskStyles.alignItems === "start" ||
      maskStyles.alignItems === "flex-start"
        ? firstLineRect.top + firstLineRect.height / 2 - currentTranslation
        : maskRect.top + maskRect.height / 2;
    storyMask.style.setProperty(
      "--story-mask-center",
      `${anchorTop - viewportTop}px`,
    );
    const lineCenters = lines.map((line) => {
      const rect = line.getBoundingClientRect();
      const paddingTop =
        Number.parseFloat(getComputedStyle(line).paddingTop) || 0;

      return (
        rect.top +
        paddingTop +
        (rect.height - paddingTop) / 2 -
        currentTranslation
      );
    });

    originOffset = anchorTop - lineCenters[0];
    lineOffsets = lineCenters.map((lineCenter) => lineCenters[0] - lineCenter);
    storyTrack.style.setProperty("--story-origin-offset", `${originOffset}px`);
  };

  const setContactRevealed = (visible: boolean, animate = false) => {
    if (visible === contactVisible) {
      return;
    }

    if (visible && animate) {
      contact.dataset.loaded = "true";
    }

    contactVisible = visible;
    contact.style.opacity = visible ? "1" : "0";
    contact.setAttribute("aria-hidden", visible ? "false" : "true");
  };

  const syncHash = (index: number) => {
    const hash = `#${lineIds[index]}`;

    if (location.hash !== hash) {
      history.replaceState(null, "", hash);
    }
  };

  const render = (
    progress: number,
    updateHash = true,
    animateContact = false,
  ) => {
    const position = clamp(progress) * lastIndex;
    const fromIndex = Math.floor(position);
    const toIndex = Math.ceil(position);
    const mix = position - fromIndex;
    scrollOffset =
      lineOffsets[fromIndex] +
      (lineOffsets[toIndex] - lineOffsets[fromIndex]) * mix;
    const nextActiveIndex = Math.round(position);

    storyTrack.style.setProperty("--story-scroll-offset", `${scrollOffset}px`);
    contact.style.top = `${
      contactPosition.getBoundingClientRect().top -
      storySection.getBoundingClientRect().top
    }px`;
    setContactRevealed(progress >= 1, animateContact);

    if (nextActiveIndex !== activeIndex) {
      activeIndex = nextActiveIndex;

      if (updateHash) {
        syncHash(activeIndex);
      }
    }
  };

  const scrollToIndex = (index: number, behavior: ScrollBehavior) => {
    syncHash(index);
    window.scrollTo({
      top: maxScroll * progressFromIndex(index),
      behavior,
    });
  };

  history.scrollRestoration = "manual";
  storyViewport.dataset.loaded = "false";
  contact.dataset.loaded = "false";

  measure();

  const initialIndex = indexFromHash();
  const initialProgress = progressFromIndex(initialIndex);
  let previousProgress = initialProgress;

  activeIndex = initialIndex;
  render(initialProgress, false);
  window.scrollTo({ top: maxScroll * initialProgress, behavior: "auto" });
  storyViewport.dataset.loaded = "true";

  window.addEventListener(
    "scroll",
    () => {
      const progress = clamp(window.scrollY / maxScroll);
      const crossingReveal = previousProgress < 1 && progress >= 1;

      render(progress, true, crossingReveal);
      previousProgress = progress;
    },
    { passive: true },
  );

  document
    .querySelectorAll<HTMLAnchorElement>("._story-scroll-to-line")
    .forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        scrollToIndex(lineIds.indexOf(link.hash.slice(1)), "smooth");
      });
    });

  window.addEventListener("hashchange", () => {
    scrollToIndex(indexFromHash(), "auto");
  });

  window.addEventListener("resize", () => {
    measure();
    render(clamp(window.scrollY / maxScroll), false);
  });
</script>
