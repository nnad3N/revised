---
import "../styles/global.css";
import Story from "../components/Story.astro";
import VisualSequence from "../components/VisualSequence.astro";
import StoryScroll from "../components/StoryScroll.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Software should feel simple. A quiet landing page for turning complex ideas into simple software."
    />
    <meta name="generator" content={Astro.generator} />
    <title>Simple Software</title>
  </head>
  <body class="bg-dark-bg text-dark-tx">
    <main
      class="mx-auto grid grid-cols-1 w-full max-w-screen-2xl max-lg:px-5 px-10 gap-x-10 gap-y-0 lg:grid-cols-2 lg:gap-y-5 lg:justify-between"
      data-story
    >
      <Story />
      <VisualSequence />
    </main>
    <StoryScroll />
  </body>
</html>
