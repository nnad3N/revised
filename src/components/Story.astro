---
import Nav from "./Nav.astro";
import StoryLine from "./StoryLine.astro";
---

<div class="flex h-screen sticky top-0 z-20 flex-col">
  <Nav />
  <section
    class="overflow-hidden copy-viewport h-full opacity-0 data-ready:opacity-100"
    data-copy-viewport
  >
    <div class="copy-track text-paper space-y-2 text-lg" data-copy-lines>
      <StoryLine id="hero-simple">software should feel simple.</StoryLine>
      <StoryLine id="mission-arrive" spaced
        >ideas rarely arrive neatly.
      </StoryLine>
      <StoryLine id="mission-people" spaced>
        they move through people before they move through systems.
      </StoryLine>
      <StoryLine id="mission-detail">
        someone points to a detail, refers back to something,
      </StoryLine>
      <StoryLine id="mission-frame">
        changes the frame, or notices what was missing.
      </StoryLine>
      <StoryLine id="mission-motion" spaced>
        good software should understand that kind of motion.
      </StoryLine>
      <StoryLine id="mission-natural">
        it should feel natural to use, clear enough to trust,
      </StoryLine>
      <StoryLine id="mission-quiet">
        and quiet enough to let the work stay in front.
      </StoryLine>
      <StoryLine id="contact-complex" spaced>
        bring me the complex idea.
      </StoryLine>
      <StoryLine id="contact-simple" spaced>
        i'll turn it into simple software.
      </StoryLine>
      <p class="contact-email opacity-0" data-email-reveal aria-hidden="true">
        <a
          class="text-paper no-underline outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
          href="mailto:hello@example.com"
          data-contact-email
          tabindex="-1"
        >
          hello@example.com
        </a>
      </p>
    </div>
  </section>
</div>

<style>
  .copy-viewport {
    --copy-core-half-height: 4rem;
    --copy-falloff-half-height: 50svh;
    --copy-mask-center: 50%;

    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--copy-mask-center) - var(--copy-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) - var(--copy-core-half-height)),
      black var(--copy-mask-center),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) + var(--copy-core-half-height)),
      transparent
        calc(var(--copy-mask-center) + var(--copy-falloff-half-height)),
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--copy-mask-center) - var(--copy-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) - var(--copy-core-half-height)),
      black var(--copy-mask-center),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) + var(--copy-core-half-height)),
      transparent
        calc(var(--copy-mask-center) + var(--copy-falloff-half-height)),
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .copy-track {
    --copy-offset: 0px;

    transform: translate3d(0, var(--copy-offset), 0);
    will-change: transform;
  }

  .contact-email {
    opacity: var(--email-opacity, 0);
    margin-top: 0;
  }

  .contact-email[data-ready] {
    transition: opacity 300ms ease;
  }

  .copy-viewport.is-email-revealed {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--copy-mask-center) - var(--copy-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) - var(--copy-core-half-height)),
      black var(--copy-mask-center),
      black 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent
        calc(var(--copy-mask-center) - var(--copy-falloff-half-height)),
      rgb(0 0 0 / 0.4)
        calc(var(--copy-mask-center) - var(--copy-core-half-height)),
      black var(--copy-mask-center),
      black 100%
    );
  }
</style>
