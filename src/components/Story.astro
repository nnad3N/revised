---
import Nav from "./Nav.astro";
import StoryLine from "./StoryLine.astro";
---

<div
  class="fixed inset-x-5 bottom-0 z-20 grid h-1/3 bg-dark-bg text-lg lg:sticky lg:inset-x-auto lg:top-0 lg:bottom-auto lg:h-screen lg:w-full"
>
  <Nav />
  <section class="relative col-start-1 row-start-1 z-40 h-full">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-50 h-32 -translate-y-1/2 bg-linear-to-b from-transparent via-dark-bg to-75% to-transparent lg:hidden"
      aria-hidden="true"
    >
    </div>
    <div
      class="_story-mask relative h-full overflow-hidden [--story-mask-center:calc(2rem+0.5lh)] lg:[--story-mask-center:50%]"
    >
      <div
        class="absolute top-(--story-mask-center) mt-[-0.5lh] w-full translate-y-(--story-scroll-offset) text-paper will-change-transform [--story-scroll-offset:0px]"
        data-story-track
      >
        <StoryLine id="hero-simple"
          >software should <i>feel</i> simple,</StoryLine
        >
        <StoryLine id="mission-arrive"
          >familiar before you know why.
        </StoryLine>
        <StoryLine id="mission-people" spaced>
          that instinct comes from the world outside the screen.
        </StoryLine>
        <StoryLine id="mission-detail">
          habits guide where you look and what you reach for.
        </StoryLine>
        <StoryLine id="mission-frame">
          expectations shape every move you make inside it.
        </StoryLine>
        <StoryLine id="mission-motion" spaced>
          good software should understand that kind of motion.
        </StoryLine>
        <StoryLine id="mission-natural">
          it should feel natural to use, clear enough to trust,
        </StoryLine>
        <StoryLine id="mission-quiet">
          and quiet enough to let the work stay in front.
        </StoryLine>
        <StoryLine id="contact-complex" spaced>
          bring me the complexity,
        </StoryLine>
        <StoryLine id="contact-simple">
          i'll turn it into simple software.
        </StoryLine>
      </div>
    </div>
    <p
      class="in-data-story-ready:transition-opacity in-data-story-ready:duration-300 in-data-story-ready:ease-in-out in-data-story-end:opacity-100 absolute inset-x-0 z-50 translate-y-(--story-scroll-offset) text-paper opacity-0 [--story-scroll-offset:0px]"
      data-story-contact
      aria-hidden="true"
    >
      <a
        class="text-inherit no-underline outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
        href="mailto:hello@example.com"
      >
        hello@example.com
      </a>
    </p>
  </section>
</div>

<style>
  ._story-mask {
    --story-core-half-height: 6rem;
    --story-falloff-half-height: 40%;
    --story-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(from var(--color-black) r g b / 0.4) 1rem,
      var(--color-black) var(--story-mask-center),
      rgb(from var(--color-black) r g b / 0.4)
        calc(var(--story-mask-center) + var(--story-core-half-height)),
      transparent 100%
    );

    -webkit-mask-image: var(--story-mask-image);
    mask-image: var(--story-mask-image);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  @media (min-width: 64rem) {
    ._story-mask {
      --story-mask-image: linear-gradient(
        to bottom,
        transparent 0%,
        transparent
          calc(var(--story-mask-center) - var(--story-falloff-half-height)),
        rgb(from var(--color-black) r g b / 0.4)
          calc(var(--story-mask-center) - var(--story-core-half-height)),
        var(--color-black) var(--story-mask-center),
        rgb(from var(--color-black) r g b / 0.4)
          calc(var(--story-mask-center) + var(--story-core-half-height)),
        transparent
          calc(var(--story-mask-center) + var(--story-falloff-half-height)),
        transparent 100%
      );
    }
  }
</style>
