---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt: string;
  priority?: boolean;
}

const { image, alt, priority = false } = Astro.props;
const textureImage = await getImage({
  src: image,
  width: image.width,
  height: image.height,
  format: "webp",
  quality: "max",
});
---

<div
  class="relative aspect-square w-full shadow-lg select-none overflow-hidden rounded-md lg:w-50vw"
>
  <Image
    src={image}
    alt={alt}
    width={image.width}
    height={image.height}
    widths={[320, 480, 640, 768, 1024, 1536, 2048]}
    sizes="(min-width: 96rem) 44.25rem, (min-width: 64rem) calc(50vw - 3.75rem), calc(100vw - 2.5rem)"
    format="webp"
    quality="max"
    priority={priority}
    draggable={false}
  />
  <div
    class="group/lens absolute inset-0 touch-pan-y data-dragging:cursor-none data-dragging:**:cursor-none"
    data-lens
    data-texture-src={textureImage.src}
  >
    <canvas
      class="pointer-events-none absolute inset-0 size-full opacity-0 transition-opacity duration-400 ease-[ease] group-data-ready/lens:opacity-100 motion-reduce:transition-none"
      aria-hidden="true"></canvas>
    <div
      class="absolute -translate-x-1/2 -translate-y-1/2 scale-(--lens-press-scale) touch-none cursor-grab rounded-full [--lens-press-scale:1]"
      data-lens-handle
      aria-hidden="true"
    >
    </div>
  </div>
</div>

<script>
  import LensWorker from "../workers/lens.worker?worker";

  const MAX_DPR = 1.5;
  const LENS_SIZE = 0.2;
  const LENS_SIZE_MIN = 0.08;
  const LENS_SIZE_MAX = 0.45;
  const LENS_SIZE_WHEEL_SENSITIVITY = 0.0002;
  const LENS_BEZEL = 0.012;
  const LENS_ZOOM = 2;
  const LENS_REFRACTION = 0.01;
  const LENS_INITIAL_CENTER = 1 - LENS_SIZE / 2;
  const LENS_HOVER_LIGHT_ANGLE = (Math.PI * 6) / 180;
  const LENS_LIGHT_ROTATE_DURATION = 300;
  const LENS_LIGHT_HOLD_DURATION = 100;
  const LENS_LIGHT_RETURN_DURATION = 400;

  interface Point {
    x: number;
    y: number;
  }

  interface LensContext {
    root: HTMLElement;
    handle: HTMLElement;
    worker: Worker;
    center: Point;
    dragOffset: Point;
    touches: Map<number, Point>;
    pinchDistance: number;
    pinchLensSize: number;
    lensSize: number;
    pointerId: number | null;
    press: number;
    pressAnimationFrame: number | null;
    lightAngle: number;
    lightAnimationFrame: number | null;
  }

  const clamp = (value: number, min: number, max: number) =>
    Math.min(Math.max(value, min), max);

  const lensZoomFromSize = (lensSize: number) =>
    LENS_ZOOM * Math.sqrt(lensSize / LENS_SIZE);

  const lensBezelFromSize = (lensSize: number) =>
    LENS_BEZEL * (lensSize / LENS_SIZE);

  const distanceBetween = (first: Point, second: Point) =>
    Math.hypot(second.x - first.x, second.y - first.y);

  const easeInOut = (progress: number) =>
    0.5 - Math.cos(progress * Math.PI) * 0.5;

  const syncHandle = (ctx: LensContext) => {
    ctx.handle.style.width = `${ctx.lensSize * 100}%`;
    ctx.handle.style.height = `${ctx.lensSize * 100}%`;
    ctx.handle.style.left = `${ctx.center.x * 100}%`;
    ctx.handle.style.top = `${ctx.center.y * 100}%`;
    ctx.handle.style.setProperty(
      "--lens-press-scale",
      `${1 + ctx.press * 0.035}`,
    );
  };

  const renderLens = (ctx: LensContext) => {
    syncHandle(ctx);
    ctx.worker.postMessage({
      type: "render",
      centerX: ctx.center.x,
      centerY: ctx.center.y,
      lensSize: ctx.lensSize,
      bezelWidth: lensBezelFromSize(ctx.lensSize),
      zoom: lensZoomFromSize(ctx.lensSize),
      refraction: LENS_REFRACTION,
      press: ctx.press,
      lightAngle: ctx.lightAngle,
    });
  };

  const animateLightNudge = (ctx: LensContext) => {
    if (ctx.lightAnimationFrame !== null) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const start = performance.now();
    const duration =
      LENS_LIGHT_ROTATE_DURATION +
      LENS_LIGHT_HOLD_DURATION +
      LENS_LIGHT_RETURN_DURATION;

    const tick = (now: number) => {
      const elapsed = clamp(now - start, 0, duration);

      if (elapsed < LENS_LIGHT_ROTATE_DURATION) {
        const progress = elapsed / LENS_LIGHT_ROTATE_DURATION;
        ctx.lightAngle = LENS_HOVER_LIGHT_ANGLE * easeInOut(progress);
      } else if (
        elapsed <
        LENS_LIGHT_ROTATE_DURATION + LENS_LIGHT_HOLD_DURATION
      ) {
        ctx.lightAngle = LENS_HOVER_LIGHT_ANGLE;
      } else {
        const returnElapsed =
          elapsed - LENS_LIGHT_ROTATE_DURATION - LENS_LIGHT_HOLD_DURATION;
        const progress = returnElapsed / LENS_LIGHT_RETURN_DURATION;
        ctx.lightAngle = LENS_HOVER_LIGHT_ANGLE * (1 - easeInOut(progress));
      }

      renderLens(ctx);

      if (elapsed < duration) {
        ctx.lightAnimationFrame = requestAnimationFrame(tick);
      } else {
        ctx.lightAngle = 0;
        ctx.lightAnimationFrame = null;
      }
    };

    ctx.lightAnimationFrame = requestAnimationFrame(tick);
  };

  const animatePress = (ctx: LensContext, target: number) => {
    if (ctx.pressAnimationFrame !== null) {
      cancelAnimationFrame(ctx.pressAnimationFrame);
    }

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      ctx.press = target;
      ctx.pressAnimationFrame = null;
      renderLens(ctx);
      return;
    }

    const from = ctx.press;
    const start = performance.now();
    const duration = target > from ? 180 : 240;

    const tick = (now: number) => {
      const progress = clamp((now - start) / duration, 0, 1);
      const eased = 1 - Math.pow(1 - progress, target > from ? 3 : 4);
      ctx.press = from + (target - from) * eased;
      renderLens(ctx);

      if (progress < 1) {
        ctx.pressAnimationFrame = requestAnimationFrame(tick);
      } else {
        ctx.press = target;
        ctx.pressAnimationFrame = null;
      }
    };

    ctx.pressAnimationFrame = requestAnimationFrame(tick);
  };

  const setLensFromPointer = (
    ctx: LensContext,
    clientX: number,
    clientY: number,
  ) => {
    const rect = ctx.root.getBoundingClientRect();
    const pointerX = (clientX - rect.left) / rect.width;
    const pointerY = (clientY - rect.top) / rect.height;

    ctx.center.x = clamp(pointerX - ctx.dragOffset.x, 0, 1);
    ctx.center.y = clamp(pointerY - ctx.dragOffset.y, 0, 1);
    renderLens(ctx);
  };

  const endDrag = (ctx: LensContext) => {
    ctx.pointerId = null;
    ctx.root.removeAttribute("data-dragging");
    animatePress(ctx, 0);
  };

  const bindInteraction = (ctx: LensContext) => {
    ctx.root.addEventListener("pointerenter", () => {
      animateLightNudge(ctx);
    });

    ctx.handle.addEventListener("pointerdown", (event) => {
      if (ctx.pointerId !== null) return;

      const rect = ctx.root.getBoundingClientRect();
      ctx.pointerId = event.pointerId;
      ctx.dragOffset.x =
        (event.clientX - rect.left) / rect.width - ctx.center.x;
      ctx.dragOffset.y =
        (event.clientY - rect.top) / rect.height - ctx.center.y;
      ctx.handle.setPointerCapture(event.pointerId);
      ctx.root.dataset.dragging = "";
      animatePress(ctx, 1);
    });

    ctx.handle.addEventListener("pointermove", (event) => {
      if (event.pointerId !== ctx.pointerId) return;
      setLensFromPointer(ctx, event.clientX, event.clientY);
    });

    const finishHandleDrag = (event: PointerEvent) => {
      if (event.pointerId !== ctx.pointerId) return;
      endDrag(ctx);
    };

    ctx.handle.addEventListener("pointerup", finishHandleDrag);
    ctx.handle.addEventListener("pointercancel", finishHandleDrag);
    ctx.handle.addEventListener("lostpointercapture", finishHandleDrag);

    ctx.root.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "touch") return;

      ctx.touches.set(event.pointerId, {
        x: event.clientX,
        y: event.clientY,
      });

      if (ctx.touches.size !== 2) return;

      if (ctx.pointerId !== null) endDrag(ctx);
      const [first, second] = Array.from(ctx.touches.values());
      ctx.pinchDistance = distanceBetween(first, second);
      ctx.pinchLensSize = ctx.lensSize;
      ctx.root.setPointerCapture(event.pointerId);
    });

    ctx.root.addEventListener("pointermove", (event) => {
      if (!ctx.touches.has(event.pointerId)) return;

      ctx.touches.set(event.pointerId, {
        x: event.clientX,
        y: event.clientY,
      });
      if (ctx.touches.size < 2 || ctx.pinchDistance === 0) return;

      const [first, second] = Array.from(ctx.touches.values());
      const distance = distanceBetween(first, second);
      ctx.lensSize = clamp(
        ctx.pinchLensSize * (distance / ctx.pinchDistance),
        LENS_SIZE_MIN,
        LENS_SIZE_MAX,
      );
      renderLens(ctx);
    });

    const finishTouch = (event: PointerEvent) => {
      ctx.touches.delete(event.pointerId);
      if (ctx.touches.size < 2) ctx.pinchDistance = 0;
    };

    ctx.root.addEventListener("pointerup", finishTouch);
    ctx.root.addEventListener("pointercancel", finishTouch);

    ctx.root.addEventListener(
      "wheel",
      (event) => {
        if (ctx.pointerId === null) return;

        event.preventDefault();
        ctx.lensSize = clamp(
          ctx.lensSize - event.deltaY * LENS_SIZE_WHEEL_SENSITIVITY,
          LENS_SIZE_MIN,
          LENS_SIZE_MAX,
        );
        renderLens(ctx);
      },
      { passive: false },
    );
  };

  const initializeLens = (root: HTMLElement) => {
    root.dataset.initialized = "";

    const canvas = root.querySelector<HTMLCanvasElement>("canvas")!;
    const handle = root.querySelector<HTMLElement>("[data-lens-handle]")!;
    const worker = new LensWorker();

    const ctx: LensContext = {
      root,
      handle,
      worker,
      center: { x: LENS_INITIAL_CENTER, y: LENS_INITIAL_CENTER },
      dragOffset: { x: 0, y: 0 },
      touches: new Map(),
      pinchDistance: 0,
      pinchLensSize: LENS_SIZE,
      lensSize: LENS_SIZE,
      pointerId: null,
      press: 0,
      pressAnimationFrame: null,
      lightAngle: 0,
      lightAnimationFrame: null,
    };
    bindInteraction(ctx);
    syncHandle(ctx);

    worker.addEventListener("message", (event) => {
      if (event.data.type === "ready") root.dataset.ready = "";
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      const size = Math.max(1, Math.round(root.clientWidth * dpr));
      worker.postMessage({ type: "resize", size });
    };

    const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
    const size = Math.max(1, Math.round(root.clientWidth * dpr));
    const offscreen = canvas.transferControlToOffscreen();
    worker.postMessage(
      {
        type: "init",
        canvas: offscreen,
        textureSrc: root.dataset.textureSrc!,
        size,
        centerX: ctx.center.x,
        centerY: ctx.center.y,
        lensSize: ctx.lensSize,
        bezelWidth: lensBezelFromSize(ctx.lensSize),
        zoom: lensZoomFromSize(ctx.lensSize),
        refraction: LENS_REFRACTION,
        press: ctx.press,
        lightAngle: ctx.lightAngle,
      },
      [offscreen],
    );

    new ResizeObserver(resize).observe(root);
  };

  document
    .querySelectorAll<HTMLElement>("[data-lens]:not([data-initialized])")
    .forEach((root) => initializeLens(root));
</script>
